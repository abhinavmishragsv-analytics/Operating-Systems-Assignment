#include <stdio.h>
#include <stdlib.h>
#include <time.h>

#define MAX 100

typedef struct {
    int pid, arrival, burst, remaining, priority;
    int completion, waiting, turnaround, response;
    int started;
} Process;

Process original[MAX], p[MAX];
int n;

// Copy original data (for ALL mode)
void copy_processes() {
    for(int i = 0; i < n; i++)
        p[i] = original[i];
}

// Generate random processes
void generate() {
    srand(time(0));
    for(int i = 0; i < n; i++) {
        original[i].pid = i+1;
        original[i].arrival = rand()%10;
        original[i].burst = (rand()%9)+1;
        original[i].remaining = original[i].burst;
        original[i].priority = rand()%5;
        original[i].started = 0;
    }
}

// Display processes
void display() {
    printf("\nPID AT BT PR\n");
    for(int i=0;i<n;i++)
        printf("%d   %d  %d  %d\n", original[i].pid, original[i].arrival, original[i].burst, original[i].priority);
}

// Print results
void print_results(char* name) {
    float wt=0,tat=0,rt=0;

    printf("\n--- %s ---\n", name);
    printf("PID WT TAT RT\n");

    for(int i=0;i<n;i++){
        printf("%d   %d  %d  %d\n", p[i].pid, p[i].waiting, p[i].turnaround, p[i].response);
        wt+=p[i].waiting;
        tat+=p[i].turnaround;
        rt+=p[i].response;
    }

    printf("Avg WT=%.2f\nAvg TAT=%.2f\nAvg RT=%.2f\n", wt/n,tat/n,rt/n);
}

// CPU Utilization
void cpu_utilization(int total_time) {
    int busy = 0;
    for(int i=0;i<n;i++) busy += p[i].burst;
    printf("CPU Utilization: %.2f%%\n", (busy*100.0)/total_time);
}

//////////////////////////////////////////////////////
// FCFS
void fcfs() {
    copy_processes();
    int time=0;

    for(int i=0;i<n;i++){
        if(time < p[i].arrival) time = p[i].arrival;

        p[i].response = time - p[i].arrival;
        time += p[i].burst;

        p[i].completion = time;
        p[i].turnaround = time - p[i].arrival;
        p[i].waiting = p[i].turnaround - p[i].burst;
    }

    print_results("FCFS");
    cpu_utilization(time);
}

//////////////////////////////////////////////////////
// SJF (Non-preemptive)
void sjf() {
    copy_processes();
    int completed=0, time=0, visited[MAX]={0};

    while(completed<n){
        int idx=-1, min=1e9;

        for(int i=0;i<n;i++){
            if(!visited[i] && p[i].arrival<=time && p[i].burst<min){
                min = p[i].burst;
                idx = i;
            }
        }

        if(idx==-1){ time++; continue; }

        p[idx].response = time - p[idx].arrival;
        time += p[idx].burst;

        p[idx].completion = time;
        p[idx].turnaround = time - p[idx].arrival;
        p[idx].waiting = p[idx].turnaround - p[idx].burst;

        visited[idx]=1;
        completed++;
    }

    print_results("SJF");
    cpu_utilization(time);
}

//////////////////////////////////////////////////////
// SRTN (Preemptive SJF)
void srtn() {
    copy_processes();
    int completed=0, time=0;

    while(completed<n){
        int idx=-1, min=1e9;

        for(int i=0;i<n;i++){
            if(p[i].arrival<=time && p[i].remaining>0 && p[i].remaining<min){
                min = p[i].remaining;
                idx = i;
            }
        }

        if(idx==-1){ time++; continue; }

        if(!p[idx].started){
            p[idx].response = time - p[idx].arrival;
            p[idx].started = 1;
        }

        p[idx].remaining--;
        time++;

        if(p[idx].remaining==0){
            completed++;
            p[idx].completion = time;
            p[idx].turnaround = time - p[idx].arrival;
            p[idx].waiting = p[idx].turnaround - p[idx].burst;
        }
    }

    print_results("SRTN");
    cpu_utilization(time);
}

//////////////////////////////////////////////////////
// Priority (Non-preemptive)
void priority_sched() {
    copy_processes();
    int completed=0, time=0, visited[MAX]={0};

    while(completed<n){
        int idx=-1, best=1e9;

        for(int i=0;i<n;i++){
            if(!visited[i] && p[i].arrival<=time && p[i].priority<best){
                best = p[i].priority;
                idx = i;
            }
        }

        if(idx==-1){ time++; continue; }

        p[idx].response = time - p[idx].arrival;
        time += p[idx].burst;

        p[idx].completion = time;
        p[idx].turnaround = time - p[idx].arrival;
        p[idx].waiting = p[idx].turnaround - p[idx].burst;

        visited[idx]=1;
        completed++;
    }

    print_results("PRIORITY");
    cpu_utilization(time);
}

//////////////////////////////////////////////////////
// Round Robin
void rr(int quantum) {
    copy_processes();
    int time=0, completed=0;

    while(completed<n){
        int done=1;

        for(int i=0;i<n;i++){
            if(p[i].remaining>0){
                done=0;

                if(p[i].arrival<=time){
                    if(!p[i].started){
                        p[i].response = time - p[i].arrival;
                        p[i].started=1;
                    }

                    if(p[i].remaining>quantum){
                        time += quantum;
                        p[i].remaining -= quantum;
                    } else {
                        time += p[i].remaining;
                        p[i].remaining=0;
                        completed++;

                        p[i].completion=time;
                        p[i].turnaround=time-p[i].arrival;
                        p[i].waiting=p[i].turnaround-p[i].burst;
                    }
                }
            }
        }

        if(done) break;
    }

    print_results("ROUND ROBIN");
    cpu_utilization(time);
}

//////////////////////////////////////////////////////
// MAIN
int main() {
    int choice;

    printf("Enter number of processes: ");
    scanf("%d",&n);

    generate();
    display();

    printf("\n1.FCFS 2.SJF 3.SRTN 4.RR 5.Priority 6.ALL\n");
    scanf("%d",&choice);

    switch(choice){
        case 1: fcfs(); break;
        case 2: sjf(); break;
        case 3: srtn(); break;
        case 4: rr(2); break;
        case 5: priority_sched(); break;
        case 6:
            fcfs();
            sjf();
            srtn();
            rr(2);
            priority_sched();
            break;
    }

    return 0;
}
